# ==============================================================================
# LibraVault Environment Variables Template
# Copy this file to .env before starting Docker Compose or deploying to production.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=libravault
POSTGRES_USER=librauser
POSTGRES_PASSWORD=librapassword

# Spring Boot Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Paper Assistant (Optional: Leave blank to use built-in Heuristic NLP Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=3.5-flash-lite

# Frontend & Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_BACKEND_URL=http://backend:8080
